<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!--
    Godot finds a C# script by its res:// path, which Godot's source generator works out from GodotProjectDir.
    This library sits in a folder of the Godot project that uses it (<project>/Shared/), so the project's
    directory is the parent: its scripts are then registered as res://Shared/<Name>.cs, where the project's
    scenes look for them. The base64 copy is the one the generator reads first. Both are set here, after
    Sdk.props, so the build output stays in this folder's own .godot/mono/temp.
    -->
    <GodotProjectDir>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))))</GodotProjectDir>
    <GodotProjectDirBase64>$([MSBuild]::ConvertToBase64('$(GodotProjectDir)'))</GodotProjectDirBase64>
  </PropertyGroup>
  <ItemGroup>
    <None Include=".gitattributes" />
    <None Include=".gitignore" />
    <None Include="README.md" />
  </ItemGroup>
</Project>
